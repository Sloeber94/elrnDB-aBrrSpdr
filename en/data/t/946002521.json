[[7,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts.</p><p>2. Remove the grab handle.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/946000673.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the interior grab handle is not damaged.</p><p>1. Position the grab handle.</p><p>2. Tighten the bolts to the specified torque.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/946000674.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]