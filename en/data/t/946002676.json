[[7,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the tailgate.</p><p>1. Undo the bolt.</p><p>2. Remove the protection.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/946000531.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,3,0,"<p>1. Remove the damper.</p><p>2. Undo the nut.</p><p>3. Remove the badge.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/946000532.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the badge is not damaged.</p><p>- Position the badge and secure it using thenut.</p><p>- Position the damper and the protection.</p><p>- Tighten the bolt.</p>"]]