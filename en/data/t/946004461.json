[[4,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the pump case oil seal.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Take care not to damage the seat when removing the oil seal.</p></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/939006225.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Moisten a new shaft oil seal with transmission fluid.</p><p>- Fit the oil seal using the special tool.</p>"]]