[[4,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Disconnect the fuel vapour pipe quick coupling, intake chamber side.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/946001758.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,3,0,"<p>1. Disconnect the fuel vapour pipe quick coupling, solenoid valve side and then remove it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/946001759.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the fuel vapour pipe in its housing and connect it to the intake chamber and to the solenoid valve using the quick coupling.</p>"]]